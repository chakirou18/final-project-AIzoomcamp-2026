# Optional overrides only; do not copy placeholders unchanged into a working environment.
# Default docker compose startup needs no .env: it generates a local password in a volume.
FIELDOPS_PORT=<available-local-port>
FIELDOPS_SUBNET=<unused-private-subnet-in-CIDR-notation>
POSTGRES_DB=<local-database-name>
POSTGRES_USER=<local-database-user>

# For running the API outside Docker with an independently configured PostgreSQL instance:
FIELDOPS_DB_HOST=<postgresql-hostname>
FIELDOPS_DB_PORT=<postgresql-port>
FIELDOPS_DB_NAME=<database-name>
FIELDOPS_DB_USER=<database-user>
FIELDOPS_DB_PASSWORD=<set-locally-never-commit>
# Alternatively set FIELDOPS_DB_PASSWORD_FILE to a readable secret file; never set both.

# T03 local session configuration (Compose supplies signing-key file and DEMO_MODE=true).
# Outside Compose, demo activation defaults to disabled.
FIELDOPS_DEMO_MODE=<true-only-for-an-intended-synthetic-demo>
FIELDOPS_SESSION_SECRET_FILE=<readable-signing-key-file-at-least-32-characters>
FIELDOPS_OPERATOR_SECRET=<set-locally-at-least-32-characters-never-commit>
# Nonlocal settings require HTTPS cookies and do not automatically seed.
FIELDOPS_ENVIRONMENT=<local-or-environment-name>
