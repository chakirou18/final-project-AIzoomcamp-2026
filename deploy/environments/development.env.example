# Development environment (automatically deployed from validated main). Copy to a host-only
# file outside git, e.g. /srv/fieldops/development/.env, and never commit real values.
COMPOSE_PROJECT_NAME=fieldops-development
FIELDOPS_IMAGE=ghcr.io/chakirou18/final-project-aizoomcamp-2026@sha256:REPLACE_WITH_DEVELOPMENT_DIGEST
FIELDOPS_ENVIRONMENT=development
FIELDOPS_DEMO_MODE=true
POSTGRES_DB=fieldops_development
POSTGRES_USER=fieldops_development
FIELDOPS_PORT=18100
FIELDOPS_GRAFANA_PORT=13100
FIELDOPS_JAEGER_PORT=16700
FIELDOPS_SUBNET=10.251.0.0/24
FIELDOPS_TEST_SUBNET=10.251.1.0/24
FIELDOPS_BROWSER_SUBNET=10.251.2.0/24
FIELDOPS_PUBLIC_URL=https://dev.fieldops.example.invalid
# Public HTTPS edge (docker-compose.proxy.yml); the proxy is the only non-loopback listener.
FIELDOPS_PUBLIC_HOST=dev.fieldops.example.invalid
FIELDOPS_ACME_EMAIL=ops@example.invalid
FIELDOPS_PROXY_HTTP=8080
FIELDOPS_PROXY_HTTPS=8443
# Private real-model provider (docker-compose.model.yml + docker-compose.model-client.yml).
# Leave FIELDOPS_ONCALL_PROVIDER unset (unconfigured) to escalate incidents safely without a model.
FIELDOPS_ONCALL_PROVIDER=ollama
FIELDOPS_ONCALL_PROVIDER_URL=http://ollama:11434
FIELDOPS_ONCALL_MODEL=llama3.2:3b
FIELDOPS_ONCALL_PROVIDER_APPROVED=true
FIELDOPS_ONCALL_PROVIDER_TIMEOUT=30
FIELDOPS_ONCALL_MAX_CALLS=1
