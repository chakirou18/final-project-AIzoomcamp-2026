# Production environment (manual promotion with required GitHub environment approval).
# Distinct Compose project, database, user, ports, subnet, volumes and secrets from development.
# DEMO_MODE enables the synthetic persona login only; fault simulation stays local-only in code.
COMPOSE_PROJECT_NAME=fieldops-production
FIELDOPS_IMAGE=ghcr.io/chakirou18/final-project-aizoomcamp-2026@sha256:REPLACE_WITH_PROMOTED_DEVELOPMENT_DIGEST
FIELDOPS_ENVIRONMENT=production
FIELDOPS_DEMO_MODE=true
POSTGRES_DB=fieldops_production
POSTGRES_USER=fieldops_production
FIELDOPS_PORT=18200
FIELDOPS_GRAFANA_PORT=13200
FIELDOPS_JAEGER_PORT=16800
FIELDOPS_SUBNET=10.252.0.0/24
FIELDOPS_TEST_SUBNET=10.252.1.0/24
FIELDOPS_BROWSER_SUBNET=10.252.2.0/24
FIELDOPS_PUBLIC_URL=https://fieldops.example.invalid
# Public HTTPS edge (docker-compose.proxy.yml); the proxy is the only non-loopback listener.
FIELDOPS_PUBLIC_HOST=fieldops.example.invalid
FIELDOPS_ACME_EMAIL=ops@example.invalid
FIELDOPS_PROXY_HTTP=80
FIELDOPS_PROXY_HTTPS=443
# Private real-model provider (docker-compose.model.yml + docker-compose.model-client.yml).
# Leave FIELDOPS_ONCALL_PROVIDER unset (unconfigured) to escalate incidents safely without a model.
FIELDOPS_ONCALL_PROVIDER=ollama
FIELDOPS_ONCALL_PROVIDER_URL=http://ollama:11434
FIELDOPS_ONCALL_MODEL=llama3.2:3b
FIELDOPS_ONCALL_PROVIDER_APPROVED=true
FIELDOPS_ONCALL_PROVIDER_TIMEOUT=30
FIELDOPS_ONCALL_MAX_CALLS=1
