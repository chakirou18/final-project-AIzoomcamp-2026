# Temporary public demo through Cloudflare Tunnel (docker-compose.public-demo.yml).
# Isolated project: its own database, volumes, network and credentials. No secrets here.
COMPOSE_PROJECT_NAME=fieldops-public-demo
POSTGRES_DB=fieldops_public_demo
POSTGRES_USER=fieldops
FIELDOPS_ENVIRONMENT=public-demo
FIELDOPS_DEMO_MODE=true
FIELDOPS_TELEMETRY_ENABLED=false
FIELDOPS_PUBLIC_DEMO_PORT=18400
FIELDOPS_PUBLIC_DEMO_REQUESTS_PER_MINUTE=120
FIELDOPS_SUBNET=10.254.40.0/24
FIELDOPS_TEST_SUBNET=10.254.41.0/24
FIELDOPS_BROWSER_SUBNET=10.254.42.0/24
