{
  "uid": "fieldops-operations",
  "title": "FieldOps - Notification reliability",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "fieldops"
  ],
  "description": "Real PostgreSQL queue and worker state. Database availability=0 means queue values are unavailable, not zero. Heartbeat age >15s is stale even when paused. Logs have derived Jaeger links. Failed events require investigation; resume does not retry them. Local demo viewer only.",
  "panels": [
    {
      "id": 1,
      "title": "Queue database available (1=yes)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "fieldops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "fieldops_metrics_database_up",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Investigate logs (last 15 minutes)",
              "url": "/explore?schemaVersion=1&panes=%7B%22A%22%3A%7B%22datasource%22%3A%22fieldops-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22expr%22%3A%22%7Bservice%3D~%5C%22fieldops-web%7Cfieldops-worker%5C%22%7D%20%7C%20json%20%7C%20event%20%21%3D%20%5C%22http_request%5C%22%20%7C%20event%20%21%3D%20%5C%22library_log%5C%22%22%2C%22queryType%22%3A%22range%22%2C%22maxLines%22%3A100%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-15m%22%2C%22to%22%3A%22now%22%7D%7D%7D"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
